{
  "name": "@rosbel/crawl-n-snap",
  "version": "1.2.0",
  "description": "CLI tool for taking website screenshots at various resolutions using Playwright, with optional website crawling functionality.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/rosbel/crawl-n-snap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosbel/crawl-n-snap.git"
  },
  "bugs": {
    "url": "https://github.com/rosbel/crawl-n-snap/issues"
  },
  "bin": {
    "crawl-n-snap": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx scripts/dev.ts",
    "dev:cli": "tsx watch src/index.ts --",
    "start": "node dist/index.js",
    "prepare": "husky install && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"ui/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"ui/src/**/*.{ts,tsx}\" --fix",
    "lint:ui": "eslint \"ui/src/**/*.{ts,tsx}\"",
    "test:ui": "vitest run",
    "format": "prettier --write .",
    "lint-staged": "lint-staged",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "playwright",
    "screenshot",
    "automation",
    "cli",
    "typescript",
    "rosbel"
  ],
  "author": "rosbel",
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "playwright": "^1.42.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@types/commander": "^2.12.2",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^3.0.9"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
